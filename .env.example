# Threat Intelligence API Keys (Optional - mocks and public feeds used when empty)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
URLHAUS_API_KEY=your_urlhaus_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
PHISHTANK_API_KEY=your_phishtank_api_key_here

# Cache and Timeout settings
CACHE_DB_PATH=cache.db
CACHE_TTL_HOURS=24
HTTP_TIMEOUT_SECONDS=5
MAX_REDIRECT_HOPS=5

# Set to true to force offline demo mode (no network requests made)
PHISHLENS_OFFLINE=false
